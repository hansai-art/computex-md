# COMPUTEX.md 環境變數樣板
#
# 複製成 `.env` 後填值。**每一項都可以留空**：留空的服務就整段不載入，
# 網站照常運作。這是刻意的，不是暫時的。
#
# ⚠️ 第三方帳號 ID 一律從這裡讀，NEVER 寫死在原始碼裡，也 NEVER 給預設值。
#
# 這條規則有具體來由。2026-07-29 盤點時發現，從 taiwan.md 取種帶進來的
# `src/layouts/Layout.astro` 把母體的兩個帳號寫死在每一頁都會載入的位置：
# GA 資源 `G-JGC5W00N7T` 與 justfont 專案 `65854`。效果是本站每一次瀏覽都把
# 訪客資料回報進別人的分析帳號，每一次載入都消耗別人的 webfont 額度，而且
# 完全沒有症狀：頁面正常、CI 全綠、沒有任何錯誤訊息。
#
# 這一類錯誤只能靠機器守。`scripts/tools/verify-no-inherited-accounts.mjs`
# 會在 postbuild 掃 dist，母體的 ID 只要出現在產出裡就擋 build。


# ── 分析 ────────────────────────────────────────────────────────────────────

# Google Analytics 4 資源 ID（格式 G-XXXXXXXXXX）。
# 留空 = 完全不載入 GA，一行 script 都不輸出。
# 目前狀態：留空。本專案還沒有自己的 GA 資源。
PUBLIC_GA_MEASUREMENT_ID=


# ── 回報 widget ─────────────────────────────────────────────────────────────

# off | github-only | mock | supabase
# 留空或 off = 退化成靜態的「到 GitHub 開 issue」按鈕，永遠是安全的。
PUBLIC_FEEDBACK_MODE=
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
PUBLIC_FEEDBACK_PROVIDERS=


# ── build 期用 ──────────────────────────────────────────────────────────────

# GitHub API token。給 prebuild 的 contributors / stars 產生器用，
# 沒有的話會撞匿名 60 req/hr 上限，統計會靜靜變成 0。
GH_TOKEN=


# ── 已移除、將來要重新接時放這裡 ────────────────────────────────────────────

# justfont webfont 專案 ID。
# 2026-07-29 整段移除（原本用的是母體的專案 65854）。要重新接上時：
#   1. 自己買 justfont 專案
#   2. 到後台拿當下的 SDK 片段，字型清單依實際購買的字型重寫
#      （舊設定指定的 jinxuanlatte / lanyanghei / lanyangming / kamabit /
#       rixingsong 都是母體買的，照抄會是錯的）
#   3. 專案 ID 從這個變數讀
# 在那之前中文字體走 Noto Sans TC / Noto Serif TC，各處 font-family 鏈本來就
# 寫著這個退路。
# PUBLIC_JUSTFONT_PROJECT_ID=
