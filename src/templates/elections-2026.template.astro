          {copy.offices.sourceNote}
        </p>
      </div>
    </section>

    <!-- 選務時程（中選會第 622 次委員會議決議） -->
    <section class="bg-white py-16 md:py-20">
      <div class="mx-auto max-w-[760px] px-6">
        <div class="mb-10 text-center">
          <h2
            class="mb-3 text-[1.5rem] font-light text-[#1f2937] md:text-[1.875rem]"
            style="font-family: 'jf-lanyangming', 'Noto Serif TC', serif;"
          >
            {copy.timeline.title}
          </h2>
          <p class="text-sm text-[#78716c]">{copy.timeline.subtitle}</p>
        </div>

        <ol class="relative border-l-[1.5px] border-[#e7d9b8] pl-6">
          {
            copy.timeline.items.map((m, i) => {
              const isDone = m.iso < todayIso;
              const isNext = i === nextMilestoneIdx;
              return (
                <li class="relative mb-6 last:mb-0">
                  <span
                    class={`absolute -left-[31px] top-1 block h-2.5 w-2.5 rounded-full border-2 ${
                      isDone
                        ? 'border-[#15803d] bg-[#15803d]'
                        : isNext
                          ? 'border-[#7c2d12] bg-[#fef2ec]'
                          : 'border-[#d1d5db] bg-white'
                    }`}
                  />
                  <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                    <span
                      class={`font-mono text-sm tabular-nums ${
                        isDone
                          ? 'text-[#15803d]'
                          : isNext
                            ? 'font-semibold text-[#7c2d12]'
                            : 'text-[#6b7280]'
                      }`}
                    >
                      {m.date}
                    </span>
                    <span
                      class={`text-base ${
                        isDone
                          ? 'text-[#6b7280]'
                          : isNext
                            ? 'font-semibold text-[#1f2937]'
                            : 'text-[#374151]'
                      }`}
                    >
                      {m.label}
                    </span>
                    {isDone && (
                      <span class="rounded-full bg-[#f0fdf4] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[#15803d]">
                        ✓ {copy.timeline.doneLabel}
                      </span>
                    )}
                    {isNext && (
                      <span class="rounded-full bg-[#fef3c7] px-2 py-0.5 font-mono text-[10px] uppercase tracking-wider text-[#92400e]">
                        {copy.timeline.nextLabel}
                      </span>
                    )}
                  </div>
                </li>
              );
            })
          }
        </ol>

        <p class="mt-8 text-center text-xs italic text-[#9ca3af]">
          {copy.timeline.sourceNote}
        </p>
      </div>
    </section>

    <!-- 持續更新中 (M3-M5 占位) -->
    <section class="bg-[#fdfaf2] py-16 md:py-20">
