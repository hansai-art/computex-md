              <a
                href="https://computex-md.pages.dev/"
                class="font-mono text-[#fbbf24] underline decoration-[#fbbf24]/40 underline-offset-2 hover:text-[#fcd34d]"
                >https://computex-md.pages.dev/</a
              >{copy.verify.domainSuffix}
            </span>
          </li>
          <li class="flex gap-3">
            <span class="text-[#4fd1b0]">→</span>
            <span>{copy.verify.gitLog}</span>
