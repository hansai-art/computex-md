        >
          <p>{copy.verify.mvp}</p>
          <p class="mt-1">{copy.verify.roadmap}</p>
          <p class="mt-4 text-base text-[#f4f0ea]">
            {copy.verify.footerPrefix}
            <span class="italic">{copy.verify.footerEmphasis}</span>
          </p>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .elections-2026 .hero-title {
    letter-spacing: -0.02em;
  }
  .elections-2026 h2 {
    letter-spacing: -0.01em;
  }
  /* Soft top blur for hero — subtle texture */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image:
      radial-gradient(
        circle at 20% 30%,
        rgba(124, 45, 18, 0.05) 0%,
        transparent 50%
      ),
      radial-gradient(
        circle at 80% 70%,
        rgba(146, 64, 14, 0.04) 0%,
        transparent 50%
      );
    pointer-events: none;
  }
</style>
