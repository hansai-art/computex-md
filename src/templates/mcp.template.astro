---
/**
 * mcp.template.astro — 給機器的入口
 *
 * 2026-07-29 整份重寫（838 行 → 這一份）。取種帶進來的是母體的 MCP / CLI 說明頁，
 * 標題是「把台灣裝進你的 AI」，教訪客執行
 *   `claude mcp add taiwanmd -- npx -y taiwanmd mcp serve`
 * 而 `taiwanmd` 是母體發佈在 npm 上的套件。照著做的人裝到的是 Taiwan.md，
 * 拿到的是台灣的資料，但整頁掛在 COMPUTEX.md 的網域下，還提供
 * `/downloads/taiwanmd.mcpb`（母體作者打包的 connector）下載。
 * 那個 .mcpb 已從 public/ 刪除，這一頁改成只寫真的存在的東西。
 *
 * 紀律：`doors` 陣列裡每一條路徑都必須在 dist 裡真的存在。
 * `scripts/tools/verify-machine-doors.mjs` 會在 postbuild 逐條驗，少一條就擋
 * build —— 一個宣稱「這裡有機器讀得到的門」的頁面自己列出 404，正好是它要
 * 解決的那個問題。
 *
 * 版面跟 about / contribute 對齊（同一組 prose 寬度、分隔線、編號欄），
 * 這三頁會被同一個人連著讀。
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { longestExhibitors } from '../lib/archive-stats';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isZh = lang === 'zh-TW';
const langPrefix = isZh ? '' : `/${lang}`;

const REPO = 'https://github.com/hansai-art/computex-md';

/**
 * 範例路徑用實際存在的廠商 slug，不寫死一個好看的字串。
 * 拿排行榜第一名（那一頁一定有內容），拿不到就退回展會頁。
 */
const sample = longestExhibitors(lang, 1)[0];
const rawSample = sample
  ? `${langPrefix}/raw/vendors/${encodeURIComponent(sample.slug)}.md`
  : `${langPrefix}/raw/editions/computex-2027.md`;

const doors = [
  {
    path: rawSample,
    label: isZh
      ? '/raw/<分類>/<slug>.md'
      : `${langPrefix}/raw/<category>/<slug>.md`,
    what: t('mcp.doors.raw.what'),
    type: 'text/markdown',
  },
  {
    path: '/llms.txt',
    label: '/llms.txt',
    what: t('mcp.doors.llms.what'),
    type: 'text/plain',
  },
  {
    path: '/api/articles.json',
    label: '/api/articles.json',
    what: t('mcp.doors.articles.what'),
    type: 'application/json',
  },
  {
    path: '/api/stats.json',
    label: '/api/stats.json',
    what: t('mcp.doors.stats.what'),
    type: 'application/json',
  },
  {
    path: '/api/search-index.json',
    label: '/api/search-index.json',
    what: t('mcp.doors.search.what'),
    type: 'application/json',
  },
  {
    path: '/sitemap-index.xml',
    label: '/sitemap-index.xml',
    what: t('mcp.doors.sitemap.what'),
    type: 'application/xml',
  },
  {
    path: '/feed.xml',
    label: '/feed.xml',
    what: t('mcp.doors.feed.what'),
    type: 'application/rss+xml',
  },
  {
    path: '/robots.txt',
    label: '/robots.txt',
    what: t('mcp.doors.robots.what'),
    type: 'text/plain',
  },
];

const wonts = [
  t('mcp.wont.1'),
  t('mcp.wont.2'),
  t('mcp.wont.3'),
  t('mcp.wont.4'),
];

const citation = isZh
  ? 'COMPUTEX.md，〈頁面標題〉，網址，取用日期。獨立開放資料專案，非 COMPUTEX 或 TAITRA 官方。'
  : 'COMPUTEX.md, "{page title}", {URL}, retrieved {date}. Independent open-data project; not affiliated with COMPUTEX or TAITRA.';

const headingClass =
  "mb-3 font-['jf-lanyangming','Noto_Serif_TC','Source_Han_Serif_TC',serif] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]";
---

<Layout
  lang={lang}
  title={t('mcp.meta.title')}
  description={t('mcp.meta.description')}
  readerSettings={true}
>
  <div class="mcp-page">
    <PageHero
      containerWidth="wide"
      padding="default"
      titleColor="#252126"
      title={t('mcp.hero.title')}
      subtitle={t('mcp.hero.subtitle')}
    />

    <div
      class="mx-auto max-w-[var(--container-prose)] px-8 pb-16 max-[480px]:px-4"
    >
      <p class="text-[1.05rem] leading-[2] text-[#374151]">{t('mcp.lead')}</p>
    </div>

    <section class="bg-[#fafbfc] px-8 py-16 max-[480px]:px-4" id="doors">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2 class={headingClass}>{t('mcp.doors.title')}</h2>
        <p class="mb-10 text-[1rem] leading-[1.9] text-[#6b7280]">
          {t('mcp.doors.lead')}
        </p>

        <ul class="m-0 flex list-none flex-col gap-0 p-0">
          {
            doors.map((d) => (
              <li class="grid grid-cols-1 gap-2 border-t border-[#e5e7eb] py-6 first:border-t-0 first:pt-0">
                <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <a
                    href={d.path}
                    class="break-all font-mono text-[0.95rem] font-semibold text-[#252126] underline decoration-[#E4007E] decoration-2 underline-offset-4 hover:text-[#E4007E]"
                  >
                    {d.label}
                  </a>
                  <span class="font-mono text-[0.75rem] text-[#9ca3af]">
                    {d.type}
                  </span>
                </div>
                <p class="m-0 text-[1rem] leading-[1.9] text-[#4b5563]">
                  {d.what}
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="px-8 py-16 max-[480px]:px-4" id="cite">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2 class={headingClass}>{t('mcp.cite.title')}</h2>
        <p class="mb-6 text-[1rem] leading-[1.9] text-[#6b7280]">
          {t('mcp.cite.lead')}
        </p>

        <p
          class="mb-2 text-[0.85rem] font-semibold uppercase tracking-[0.08em] text-[#9ca3af]"
        >
          {t('mcp.cite.format')}
        </p>
        <pre
          class="m-0 overflow-x-auto rounded-lg bg-[#252126] px-5 py-4 text-[0.85rem] leading-[1.8] text-[#f5f4f4]"><code>{citation}</code></pre>

        <p class="mt-6 text-[1rem] leading-[1.9] text-[#4b5563]">
          {t('mcp.cite.note')}
        </p>
      </div>
    </section>

    <section class="bg-[#fafbfc] px-8 py-16 max-[480px]:px-4" id="server">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2 class={headingClass}>{t('mcp.mcp.title')}</h2>
        <p
          class="mb-6 inline-block rounded-full bg-[#252126] px-4 py-1.5 text-[0.85rem] font-semibold text-white"
        >
          {t('mcp.mcp.status')}
        </p>
        <p class="mb-4 text-[1rem] leading-[1.9] text-[#4b5563]">
          {t('mcp.mcp.body')}
        </p>
        <p class="mb-8 text-[1rem] leading-[1.9] text-[#4b5563]">
          {t('mcp.mcp.meanwhile')}
        </p>
        <a
          href={REPO}
          rel="noopener"
          class="inline-block rounded-lg bg-[#252126] px-8 py-3 text-[0.95rem] font-semibold text-white no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#E4007E]"
          >{t('mcp.mcp.cta')}</a
        >
      </div>
    </section>

    <section class="px-8 py-16 max-[480px]:px-4" id="wont">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2 class={headingClass}>{t('mcp.wont.title')}</h2>
        <p class="mb-8 text-[1rem] leading-[1.9] text-[#6b7280]">
          {t('mcp.wont.lead')}
        </p>

        <ol
          class="m-0 flex list-none flex-col gap-0 border-t border-[#e5e7eb] p-0"
        >
          {
            wonts.map((w, i) => (
              <li class="flex items-baseline gap-4 border-b border-[#e5e7eb] py-4">
                <span
                  class="text-[0.85rem] font-bold text-[#9ca3af] [font-variant-numeric:tabular-nums]"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-[1rem] leading-[1.8] text-[#374151]">
                  {w}
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>
</Layout>
