---
/**
 * explore.template.astro — 檔案庫的「來找東西的人」入口。
 *
 * 這一頁的**定位**是從母體繼承的，而且對展會版一樣成立：首頁給「來讀故事的
 * 人」，/explore 給「來找特定東西的人」，兩種訪客的動線不該混在同一頁。骨架
 * （搜尋優先 + 分類卡 + 其他入口）留著。
 *
 * 2026-07-29 換掉的是資料來源與內容，因為它們整組指著母體：
 *
 *   1. **第十、十一份寫死的分類表。** frontmatter 有兩份母體 12 分類的硬編碼
 *      清單（一份給 fallback 計數、一份給精選掃描），資料夾名一個都對不上，
 *      所以「深度精選」永遠掃出 0 筆、統計 fallback 永遠是 0，而且不會報錯。
 *      同一個形狀的坑這是第十次，全部改吃 `src/config/categories.mjs` 正本。
 *   2. **`contributors = 61`** 寫死在 fallback 裡 —— 那是母體的貢獻者數。
 *   3. **深度精選的判準是腳註數 ≥ 18**。母體的文章有腳註，我們的廠商頁是事實
 *      表格，一條腳註都沒有，所以這個區塊在這個物種上恆為空。換成「參展屆數
 *      最多的廠商」：純機械、可回查，而且跟未來 Booth Score 同一個性質。
 *   4. **熱門文章（GA 近 7 天）**：站還沒上線，沒有 GA 資料，區塊恆為空，而且
 *      它的分類對照也是母體那份。整段移除，等真的有流量再重接。
 *   5. **`/map` 與 `/terminology` 兩張卡**：母體才有的路由，本站沒有。它們是
 *      `verify-internal-links` KNOWN_DEBT 裡 5 條中的 4 條。換成這個專案真正
 *      該推的三道門：關聯圖、llms.txt、/raw/ 的純 Markdown 分身。
 *
 * 熱門搜尋詞不手寫，從實際資料現算（展區 + 館別）。手寫的熱門詞很容易變成
 * 「點了搜出 0 筆」，那比沒有還糟。
 */
import { withTrailingSlash } from '../utils/href';
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import { useTranslations, getLangFromUrl } from '../i18n/utils';
import { getLatestArticles } from '../utils/articles-index';
import { getCategoryConfigs, categoryList } from '../utils/categoryConfig';
import { getArchiveStats, longestExhibitors } from '../lib/archive-stats';
import { CATEGORY_MAPPING } from '../config/categories';
import { LANGUAGES, DEFAULT_LANGUAGE } from '../config/languages';
import matter from 'gray-matter';
import { readFileSync, readdirSync } from 'node:fs';
import { resolve, join } from 'node:path';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isZh = lang === 'zh-TW';
const langUrlPrefix = isZh ? '' : `/${lang}`;

const stats = getArchiveStats(lang);
const exploreCats = getCategoryConfigs(t) as Record<string, any>;

const latestForExplore = await getLatestArticles(lang, 8);
const exploreLatestDay = (d: string) => {
  const dt = new Date(d);
  return isZh
    ? `${dt.getMonth() + 1}/${dt.getDate()}`
    : dt.toLocaleDateString(lang === 'en' ? 'en-US' : lang, {
        month: 'short',
        day: 'numeric',
      });
};

// ── Hero 統計條：四個現算的數字。母體這裡掛的是文章數 / 貢獻者 / 語言數 /
//    近 30 天更新，其中貢獻者是寫死的 61。 ──
const heroFigures = [
  { value: String(stats.totalPages), label: t('explore.stats.pages') },
  { value: String(stats.vendors), label: t('explore.stats.vendors') },
  { value: String(stats.editionsCovered), label: t('explore.stats.editions') },
  {
    value: stats.earliestYear ? String(stats.earliestYear) : '—',
    label: t('explore.stats.span'),
  },
];

/**
 * 熱門搜尋詞 = 實際資料裡出現最多次的展區與館別。
 *
 * 每一個詞都保證搜得到東西（它就是從頁面內容統計出來的），而且會跟著資料長。
 * 展區名很長，取括號前的中文段當 chip 文字，搜尋時仍送完整字串。
 */
function deriveHotTerms(): Array<{ label: string; term: string }> {
  const dir = resolve(
    process.cwd(),
    ...(isZh ? ['knowledge'] : ['knowledge', lang]),
    CATEGORY_MAPPING.vendors,
  );
  const zoneCount = new Map<string, number>();
  const hallCount = new Map<string, number>();
  try {
    for (const f of readdirSync(dir)) {
      if (!f.endsWith('.md') || f.startsWith('_')) continue;
      const raw = readFileSync(join(dir, f), 'utf-8');
      const { data } = matter(raw);
      const zone = data?.vendor?.show_area;
      if (typeof zone === 'string' && zone.trim()) {
        zoneCount.set(zone, (zoneCount.get(zone) || 0) + 1);
      }
      const hall = raw.match(/台北南港展覽館 \d 館|台北世貿[一二三]館/)?.[0];
      if (hall) hallCount.set(hall, (hallCount.get(hall) || 0) + 1);
    }
  } catch {
    // 資料夾不在（例如某語言還沒有內容）→ 沒有 chip，區塊自己收掉
  }
  const top = (m: Map<string, number>, n: number) =>
    [...m.entries()].sort((a, b) => b[1] - a[1]).slice(0, n);
  return [
    ...top(zoneCount, 2).map(([term]) => ({
      label: term.replace(/\s*[（(].*$/, ''),
      term,
    })),
    ...top(hallCount, 2).map(([term]) => ({ label: term, term })),
  ];
}
const hotSearchTerms = deriveHotTerms();

// ── 參展屆數最多的廠商。取代母體那個「腳註數 ≥ 18」的深度精選。 ──
const longest = longestExhibitors(lang, 6);

// ── 隨機探索腳本要的語言與分類清單（沿用母體的 SSOT 推導，那部分是對的）──
const nonDefaultLangCodes = LANGUAGES.filter(
  (l) => l.enabled && l.code !== DEFAULT_LANGUAGE.code,
).map((l) => l.code);
const defaultLangCode = DEFAULT_LANGUAGE.code;
const langPrefixesLower = [
  ...nonDefaultLangCodes,
  defaultLangCode.toLowerCase(),
];
const routedCats = categoryList;

const REPO = 'https://github.com/hansai-art/computex-md';
/** /raw/ 分身的示範連結：拿最久的那一家，沒有資料就退回廠商索引。 */
const rawSample = longest[0]
  ? `${langUrlPrefix}/raw/vendors/${encodeURIComponent(longest[0].slug)}.md`
  : `${langUrlPrefix}/vendors`;
---

<Layout
  lang={lang}
  title={t('explore.meta.title')}
  description={t('explore.meta.description')}
  readerSettings
>
  <div class="explore-page">
    <PageHero
      bgVariant="solid"
      bgColor="#252126"
      bgTone="dark"
      titleVariant="inherit"
      containerWidth="wide"
      eyebrow={t('explore.hero.eyebrow')}
      title={t('explore.hero.title')}
      subtitle={t('explore.hero.subtitle')}
      accentColor="rgba(255,255,255,0.7)"
    >
      <div
        slot="meta"
        class="mt-6 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-[0.95rem] tracking-[0.05em] opacity-85"
      >
        {
          heroFigures.map((f, i) => (
            <>
              {i > 0 && <span class="opacity-50">·</span>}
              <span>
                <strong class="font-bold [font-variant-numeric:tabular-nums]">
                  {f.value}
                </strong>{' '}
                {f.label}
              </span>
            </>
          ))
        }
      </div>
    </PageHero>

    <!-- ====== SEARCH ====== -->
    <section
      class="relative -mt-12 mb-10 px-4 max-[768px]:-mt-8 max-[768px]:mb-8"
    >
      <div
        class="mx-auto max-w-[820px] rounded-[18px] border border-[#e2e8f0] bg-white p-6 shadow-[0_18px_50px_rgba(15,23,42,0.12),0_4px_12px_rgba(15,23,42,0.06)] max-[768px]:p-4"
      >
        <div class="flex gap-3 max-[600px]:flex-col">
          {
            /* 假的輸入框，點下去開全站共用的搜尋 modal（Layout.astro 那一個實例） */
          }
          <button
            type="button"
            id="explore-search-trigger"
            class="group flex flex-1 items-center gap-3 rounded-xl border-2 border-[#cbd5e1] bg-[#f8fafc] px-5 py-[0.95rem] text-left transition-all hover:border-[#E4007E] hover:bg-white focus:border-[#E4007E] focus:bg-white focus:outline-none"
            aria-label={t('explore.search.heading')}
          >
            <svg
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="#64748b"
              stroke-width="2.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="flex-shrink-0 transition-colors group-hover:stroke-[#E4007E]"
            >
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
            <span
              class="flex-1 text-[1rem] font-medium text-[#94a3b8] max-[480px]:text-[0.9rem]"
            >
              {t('explore.search.placeholder')}
            </span>
            <kbd
              class="hidden flex-shrink-0 rounded border border-[#e2e8f0] bg-white px-2 py-[0.15rem] font-mono text-[0.75rem] font-semibold text-[#64748b] sm:inline-block"
              >/</kbd
            >
          </button>

          <button
            type="button"
            id="explore-random-btn"
            class="group flex items-center justify-center gap-2 rounded-xl border-2 border-[#252126] bg-[#252126] px-5 py-[0.95rem] font-bold text-white transition-all hover:-translate-y-px hover:bg-[#E4007E] hover:border-[#E4007E] active:translate-y-0 max-[600px]:py-3"
            aria-label={t('explore.search.random')}
          >
            <span class="text-[0.95rem]">{t('explore.search.random')}</span>
          </button>
        </div>

        {
          hotSearchTerms.length > 0 && (
            <div class="mt-4 flex flex-wrap items-center gap-2 max-[600px]:gap-1.5">
              <span class="mr-1 text-[0.85rem] font-semibold text-[#475569] max-[480px]:text-[0.8rem]">
                {t('explore.hotSearches.label')}
              </span>
              {hotSearchTerms.map((chip) => (
                <button
                  type="button"
                  class="hot-chip rounded-full border border-[#e2e8f0] bg-[#f1f5f9] px-3 py-[0.3rem] text-[0.85rem] font-medium text-[#475569] transition-all hover:-translate-y-px hover:border-[#E4007E] hover:text-[#252126] max-[480px]:px-2.5 max-[480px]:py-1 max-[480px]:text-[0.78rem]"
                  data-term={chip.term}
                >
                  {chip.label}
                </button>
              ))}
            </div>
          )
        }
      </div>
    </section>

    <!-- ====== CATEGORIES ====== -->
    <section class="my-16 max-[768px]:my-10">
      <div class="mb-6 px-4 text-center">
        <h2
          class="hero-title mb-2 text-[2rem] font-black -tracking-[0.02em] text-[#252126] max-[768px]:text-[1.6rem]"
        >
          {t('explore.categories.heading')}
        </h2>
        <p
          class="mx-auto max-w-[600px] text-[1.05rem] leading-[1.6] text-[#64748b] max-[480px]:text-[0.95rem]"
        >
          {t('explore.categories.subtitle')}
        </p>
      </div>
      <CategoryGrid />
    </section>

    <!-- ====== 最新更新 ====== -->
    {
      latestForExplore.length > 0 && (
        <section class="mx-auto my-16 max-w-[860px] px-8 max-[768px]:my-10 max-[768px]:px-4">
          <div class="mb-6 flex items-end justify-between gap-4">
            <div>
              <h2 class="hero-title text-[2rem] font-black -tracking-[0.02em] text-[#252126] max-[768px]:text-[1.6rem]">
                {t('latest.title')}
              </h2>
              <p class="mt-1 text-[0.95rem] text-[#64748b]">
                {t('latest.exploreSub')}
              </p>
            </div>
            <a
              href={withTrailingSlash(`${langUrlPrefix}/latest`)}
              class="flex-shrink-0 whitespace-nowrap text-[0.88rem] font-semibold text-[#252126] no-underline underline-offset-4 hover:underline hover:decoration-[#E4007E]"
              data-ga-section="explore_latest"
              data-ga-label="view_all"
            >
              {t('latest.exploreSeeAll')}
            </a>
          </div>
          <div class="flex flex-col gap-1">
            {latestForExplore.map((a) => {
              const cfg = exploreCats[a.category] || {};
              return (
                <a
                  href={withTrailingSlash(
                    `${langUrlPrefix}/${a.category}/${encodeURIComponent(a.slug)}`,
                  )}
                  class="group flex items-center gap-3 rounded-lg border border-transparent px-3 py-2.5 no-underline transition-all hover:border-[#e2e8f0] hover:bg-[#f8fafc]"
                  data-ga-section="explore_latest"
                >
                  <span
                    class="flex-shrink-0 rounded-full px-[0.5rem] py-[0.15rem] text-[0.68rem] font-semibold"
                    style={`color:${cfg.color || '#64748b'}; background:${cfg.colorLight || '#f1f5f9'};`}
                  >
                    {cfg.name}
                  </span>
                  <span class="min-w-0 flex-1 truncate font-[family-name:var(--font-body)] text-[0.98rem] font-semibold text-[#252126] group-hover:text-[#E4007E]">
                    {a.title}
                  </span>
                  <span class="flex-shrink-0 font-mono text-[0.76rem] tabular-nums text-[#94a3b8]">
                    {exploreLatestDay(a.date)}
                  </span>
                </a>
              );
            })}
          </div>
        </section>
      )
    }

    <!-- ====== 參展最久的廠商 ====== -->
    {
      longest.length > 0 && (
        <section class="mx-auto my-16 max-w-[860px] px-8 max-[768px]:my-10 max-[768px]:px-4">
          <div class="mb-8">
            <h2 class="hero-title mb-2 text-[2rem] font-black -tracking-[0.02em] text-[#252126] max-[768px]:text-[1.6rem]">
              {t('explore.longest.heading')}
            </h2>
            <p class="max-w-[640px] text-[1.05rem] leading-[1.6] text-[#64748b] max-[480px]:text-[0.95rem]">
              {t('explore.longest.subtitle')}
            </p>
          </div>

          <ol class="m-0 flex list-none flex-col gap-0 p-0">
            {longest.map((v, i) => (
              <li class="border-t border-[#e5e7eb] first:border-t-0">
                <a
                  href={withTrailingSlash(
                    `${langUrlPrefix}/vendors/${encodeURIComponent(v.slug)}`,
                  )}
                  class="group grid grid-cols-[auto_1fr_auto] items-baseline gap-x-5 py-5 no-underline max-[480px]:gap-x-3"
                  data-ga-section="explore_longest"
                >
                  <span
                    class="text-[0.85rem] font-bold text-[#9ca3af] [font-variant-numeric:tabular-nums]"
                    aria-hidden="true"
                  >
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <span class="min-w-0">
                    <span class="block truncate text-[1.05rem] font-semibold text-[#252126] group-hover:text-[#E4007E]">
                      {v.name}
                    </span>
                    <span class="mt-1 block text-[0.85rem] text-[#9ca3af]">
                      {t('explore.longest.since')} {v.since}
                    </span>
                  </span>
                  <span class="whitespace-nowrap text-[0.95rem] font-bold text-[#252126] [font-variant-numeric:tabular-nums]">
                    {v.editions} {t('explore.longest.editions')}
                  </span>
                </a>
              </li>
            ))}
          </ol>

          <p class="mt-6">
            <a
              href={withTrailingSlash(`${langUrlPrefix}/vendors`)}
              class="inline-block border-b-2 border-[#E4007E] pb-1 text-[0.95rem] font-semibold text-[#252126] no-underline transition-colors duration-200 hover:text-[#E4007E]"
            >
              {t('explore.longest.viewAll')}
            </a>
          </p>
        </section>
      )
    }

    <!-- ====== 機器可讀入口 ====== -->
    <section
      class="mx-auto my-16 max-w-[var(--container-wide)] px-8 max-[768px]:my-10 max-[768px]:px-4"
    >
      <div class="mb-8">
        <h2
          class="hero-title mb-2 text-[1.6rem] font-black -tracking-[0.02em] text-[#252126] max-[768px]:text-[1.35rem]"
        >
          {t('explore.machine.heading')}
        </h2>
        <p class="max-w-[640px] text-[1rem] leading-[1.6] text-[#64748b]">
          {t('explore.machine.subtitle')}
        </p>
      </div>
      <div
        class="grid grid-cols-3 gap-5 max-[900px]:grid-cols-1 max-[900px]:gap-4"
      >
        {
          [
            {
              href: withTrailingSlash(`${langUrlPrefix}/organism`),
              title: t('explore.machine.organism.title'),
              desc: t('explore.machine.organism.desc'),
              cta: t('explore.machine.organism.cta'),
              external: false,
            },
            {
              href: '/llms.txt',
              title: t('explore.machine.llms.title'),
              desc: t('explore.machine.llms.desc'),
              cta: t('explore.machine.llms.cta'),
              external: true,
            },
            {
              href: rawSample,
              title: t('explore.machine.raw.title'),
              desc: t('explore.machine.raw.desc'),
              cta: t('explore.machine.raw.cta'),
              external: true,
            },
          ].map((card) => (
            <a
              href={card.href}
              target={card.external ? '_blank' : undefined}
              rel={card.external ? 'noopener noreferrer' : undefined}
              class="group flex flex-col rounded-2xl border border-[#e2e8f0] bg-white p-6 no-underline transition-all hover:-translate-y-1 hover:border-[#E4007E]"
              data-ga-section="explore_machine"
            >
              <h3 class="mb-2 text-[1.05rem] font-bold text-[#252126] group-hover:text-[#E4007E]">
                {card.title}
              </h3>
              <p class="mb-4 flex-1 text-[0.88rem] leading-[1.55] text-[#64748b]">
                {card.desc}
              </p>
              <span class="text-[0.85rem] font-semibold text-[#252126] group-hover:text-[#E4007E]">
                {card.cta}
              </span>
            </a>
          ))
        }
      </div>
    </section>

    <!-- ====== CTA ====== -->
    <section
      class="mx-auto my-20 max-w-[760px] rounded-3xl border border-[#e5e7eb] bg-[#fafbfc] px-10 py-12 text-center max-[768px]:my-12 max-[768px]:px-6 max-[768px]:py-8"
    >
      <h2
        class="mb-3 text-[1.5rem] font-black -tracking-[0.01em] text-[#252126] max-[768px]:text-[1.25rem]"
      >
        {t('explore.cta.heading')}
      </h2>
      <p
        class="mx-auto mb-6 max-w-[560px] text-[1rem] leading-[1.65] text-[#374151] max-[480px]:text-[0.95rem]"
      >
        {t('explore.cta.body')}
      </p>
      <div
        class="flex flex-wrap justify-center gap-3 max-[480px]:flex-col max-[480px]:items-stretch"
      >
        <a
          href={withTrailingSlash(`${langUrlPrefix}/contribute`)}
          class="rounded-lg bg-[#252126] px-6 py-3 text-[0.95rem] font-semibold text-white no-underline transition-all hover:-translate-y-px hover:bg-[#E4007E]"
        >
          {t('explore.cta.contribute')}
        </a>
        <a
          href={REPO}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-lg border-2 border-[#252126] bg-white px-6 py-3 text-[0.95rem] font-semibold text-[#252126] no-underline transition-all hover:-translate-y-px hover:bg-[#252126] hover:text-white"
        >
          {t('explore.cta.github')}
        </a>
      </div>
    </section>
  </div>
</Layout>

<script
  is:inline
  define:vars={{
    nonDefaultLangCodes,
    defaultLangCode,
    langPrefixesLower,
    routedCats,
  }}
>
  // ── Search trigger: open global modal + focus input ──
  function openSearchModal(prefill) {
    var modal = document.getElementById('search-modal');
    var input = document.getElementById('search-input');
    if (!modal || !input) return;
    modal.classList.add('open');
    if (typeof prefill === 'string' && prefill.length > 0) {
      input.value = prefill;
      // The Layout.astro search initializer attaches an `input` listener;
      // dispatch one so results render for the prefilled term.
      input.dispatchEvent(new Event('input', { bubbles: true }));
    }
    setTimeout(function () {
      input.focus();
      if (typeof prefill === 'string' && prefill.length > 0) {
        var len = input.value.length;
        try {
          input.setSelectionRange(len, len);
        } catch (_) {}
      }
    }, 100);
  }

  document.addEventListener('DOMContentLoaded', function () {
    var trigger = document.getElementById('explore-search-trigger');
    if (trigger) {
      trigger.addEventListener('click', function () {
        openSearchModal();
      });
    }

    document.querySelectorAll('.hot-chip').forEach(function (chip) {
      chip.addEventListener('click', function () {
        var term = chip.getAttribute('data-term');
        if (term) openSearchModal(term);
      });
    });

    // Random button — pick a random article from /api/articles.json
    // filtered by current language.
    var randomBtn = document.getElementById('explore-random-btn');
    if (randomBtn) {
      randomBtn.addEventListener('click', async function () {
        randomBtn.style.pointerEvents = 'none';
        randomBtn.style.opacity = '0.7';
        try {
          var pathLang = (location.pathname.split('/')[1] || '').toLowerCase();
          var currentLang =
            nonDefaultLangCodes.indexOf(pathLang) >= 0
              ? pathLang
              : defaultLangCode;
          var res = await fetch('/api/articles.json');
          if (!res.ok) throw new Error('articles fetch failed');
          var raw = await res.json();
          var pool = raw.filter(function (a) {
            var cat = (a.category || '').toLowerCase();
            if (currentLang === defaultLangCode) {
              if (langPrefixesLower.indexOf(cat) !== -1) return false;
            } else if (cat !== currentLang) {
              return false;
            }
            var s = a.url
              .replace('https://computex.taiwanai.ngo', '')
              .split('/');
            var urlCat = s.length >= 2 ? s[s.length - 2].toLowerCase() : '';
            return routedCats.indexOf(urlCat) !== -1;
          });
          if (pool.length === 0) throw new Error('empty pool');
          var pick = pool[Math.floor(Math.random() * pool.length)];
          var segs = pick.url
            .replace('https://computex.taiwanai.ngo', '')
            .split('/');
          if (segs.length >= 2) {
            segs[segs.length - 2] = segs[segs.length - 2].toLowerCase();
          }
          location.href = segs.join('/');
        } catch (e) {
          randomBtn.style.pointerEvents = '';
          randomBtn.style.opacity = '';
          // Silent fail — keep the page usable.
        }
      });
    }
  });
</script>
