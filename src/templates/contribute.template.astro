---
/**
 * contribute.template.astro — 參與編輯
 *
 * 2026-07-29 整份重寫。取種帶進來的是 taiwan-md 的貢獻頁：2,192 行、九個區塊。
 * 裡面有三樣東西不能留：
 *
 *   1. `<form id="contribute-form">` 把訪客的**姓名 + email + 內容** POST 到
 *      母體的 Google Apps Script 端點（`script.google.com/macros/s/AKfycbzu…`），
 *      然後顯示「送出成功」。填的人以為投稿給我們，資料其實進了別人的試算表。
 *      這是活的資料外洩，不是外觀殘留，所以整個表單直接拿掉 —— 本站沒有後端，
 *      沒有能收這些資料的地方，補一個假的收件端只是換一種騙法。
 *   2. 「捐 token 幫忙翻譯成 8 個語言」整段：本站只有 zh-TW + en，而且它給的
 *      兩個連結指向私有 repo 的檔案，點了都是 404。
 *   3. CLI 區段推銷 `npx taiwanmd@latest search 珍珠奶茶` —— 那是母體發佈在
 *      npm 上的套件，不是我們的。
 *
 * 新版的骨幹是「權限 → 送法 → 處理 → 界線 → 還沒開放的」。
 * 第四段（本站不做的四件事）是這一頁存在的理由：廠商共編的檔案，可信度全部
 * 押在那四條上。它們用否定句寫，因為肯定句留得下解釋空間，否定句留不下。
 *
 * 版面刻意跟 about.template.astro 對齊（同一組 prose 寬度、分隔線、編號欄），
 * 兩頁會被同一個人連著讀。
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isZh = lang === 'zh-TW';
const langPrefix = isZh ? '' : `/${lang}`;

const CONTACT = 'hans@groupg.org';

/** 先把五個欄位填好再開信 —— 讓對方覆蓋，而不是從空白信開始寫。 */
const mailtoTemplate = `mailto:${CONTACT}?subject=${encodeURIComponent(
  t('contribute.mail.subject'),
)}&body=${encodeURIComponent(t('contribute.mail.body'))}`;

const paths = [
  {
    n: '01',
    title: t('contribute.paths.fact.title'),
    who: t('contribute.paths.fact.who'),
    body: t('contribute.paths.fact.body'),
    note: t('contribute.paths.fact.note'),
  },
  {
    n: '02',
    title: t('contribute.paths.claim.title'),
    who: t('contribute.paths.claim.who'),
    body: t('contribute.paths.claim.body'),
    note: t('contribute.paths.claim.note'),
  },
  {
    n: '03',
    title: t('contribute.paths.curation.title'),
    who: t('contribute.paths.curation.who'),
    body: t('contribute.paths.curation.body'),
    note: t('contribute.paths.curation.note'),
  },
];

const howItems = [
  t('contribute.how.item1'),
  t('contribute.how.item2'),
  t('contribute.how.item3'),
  t('contribute.how.item4'),
  t('contribute.how.item5'),
];

const processSteps = [
  t('contribute.process.step1'),
  t('contribute.process.step2'),
  t('contribute.process.step3'),
  t('contribute.process.step4'),
];

const rules = [
  t('contribute.rules.one'),
  t('contribute.rules.two'),
  t('contribute.rules.three'),
  t('contribute.rules.four'),
];

const soon = [
  {
    title: t('contribute.soon.score.title'),
    body: t('contribute.soon.score.body'),
  },
];

const REPO = 'https://github.com/hansai-art/computex-md';
---

<Layout
  lang={lang}
  title={t('contribute.meta.title')}
  description={t('contribute.meta.description')}
  readerSettings={true}
>
  <div class="contribute-page">
    <PageHero
      containerWidth="wide"
      padding="default"
      titleColor="#252126"
      title={t('contribute.hero.title')}
      subtitle={t('contribute.hero.subtitle')}
    />

    <div
      class="mx-auto max-w-[var(--container-prose)] px-8 pb-16 max-[480px]:px-4"
    >
      <p class="text-[1.05rem] leading-[2] text-[#374151]">
        {t('contribute.lead')}
      </p>
    </div>

    <section class="bg-[#fafbfc] px-8 py-16 max-[480px]:px-4" id="paths">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-3 font-[family-name:var(--font-display)] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('contribute.paths.title')}
        </h2>
        <p class="mb-10 text-[1rem] leading-[1.9] text-[#6b7280]">
          {t('contribute.paths.lead')}
        </p>

        <ol class="m-0 flex list-none flex-col gap-0 p-0">
          {
            paths.map((p) => (
              <li class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-[#e5e7eb] py-8 first:border-t-0 first:pt-0 max-[480px]:gap-x-4 max-[480px]:py-6">
                <span
                  class="row-span-4 pt-1 text-[1.05rem] font-bold text-[#E4007E] [font-variant-numeric:tabular-nums]"
                  aria-hidden="true"
                >
                  {p.n}
                </span>
                <h3 class="m-0 text-[1.2rem] font-bold leading-snug text-[#252126]">
                  {p.title}
                </h3>
                <p class="m-0 text-[0.9rem] leading-[1.8] text-[#6b7280]">
                  <strong class="font-semibold text-[#374151]">
                    {t('contribute.paths.whoLabel')}
                  </strong>{' '}
                  {p.who}
                </p>
                <p class="m-0 text-[1rem] leading-[1.9] text-[#4b5563]">
                  {p.body}
                </p>
                <p class="m-0 text-[0.9rem] leading-[1.8] text-[#6b7280]">
                  <strong class="font-semibold text-[#374151]">
                    {t('contribute.paths.noteLabel')}
                  </strong>{' '}
                  {p.note}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="px-8 py-16 max-[480px]:px-4" id="how">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-3 font-[family-name:var(--font-display)] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('contribute.how.title')}
        </h2>
        <p class="mb-8 text-[1rem] leading-[1.9] text-[#6b7280]">
          {t('contribute.how.lead')}
        </p>

        <ol
          class="m-0 flex list-none flex-col gap-0 border-t border-[#e5e7eb] p-0"
        >
          {
            howItems.map((item, i) => (
              <li class="flex items-baseline gap-4 border-b border-[#e5e7eb] py-4">
                <span
                  class="text-[0.85rem] font-bold text-[#9ca3af] [font-variant-numeric:tabular-nums]"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="text-[1rem] leading-[1.8] text-[#374151]">
                  {item}
                </span>
              </li>
            ))
          }
        </ol>

        <div class="mt-10">
          <a
            href={mailtoTemplate}
            data-ga-section="contribute_how"
            data-ga-label="mailto_template"
            class="inline-block rounded-lg bg-[#252126] px-8 py-3 text-[0.95rem] font-semibold text-white no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#E4007E]"
            >{t('contribute.how.cta')}</a
          >
          <p class="mt-3 text-[0.85rem] leading-[1.8] text-[#9ca3af]">
            {t('contribute.how.ctaNote')}
          </p>
        </div>

        {/* repo 2026-07-29 轉公開，PR 從「還沒開放」升成真的送得出來的路。 */}
        <div class="mt-12 border-t border-[#e5e7eb] pt-10">
          <h3 class="m-0 text-[1.2rem] font-bold leading-snug text-[#252126]">
            {t('contribute.pr.title')}
          </h3>
          <p class="mt-3 text-[1rem] leading-[1.9] text-[#4b5563]">
            {t('contribute.pr.body')}
          </p>
          <p class="mt-5">
            <a
              href={REPO}
              target="_blank"
              rel="noopener noreferrer"
              data-ga-section="contribute_how"
              data-ga-label="repo"
              class="inline-block border-b-2 border-[#E4007E] pb-1 text-[0.95rem] font-semibold text-[#252126] no-underline transition-colors duration-200 hover:text-[#E4007E]"
              >{t('contribute.pr.cta')}</a
            >
          </p>
        </div>
      </div>
    </section>

    <section class="bg-[#fafbfc] px-8 py-16 max-[480px]:px-4" id="process">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-8 font-[family-name:var(--font-display)] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('contribute.process.title')}
        </h2>
        <ol class="m-0 flex list-none flex-col gap-0 p-0">
          {
            processSteps.map((step, i) => (
              <li class="grid grid-cols-[auto_1fr] gap-x-6 border-t border-[#e5e7eb] py-6 first:border-t-0 first:pt-0 max-[480px]:gap-x-4">
                <span
                  class="pt-1 text-[0.95rem] font-bold text-[#E4007E] [font-variant-numeric:tabular-nums]"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <p class="m-0 text-[1rem] leading-[1.9] text-[#4b5563]">
                  {step}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="px-8 py-16 max-[480px]:px-4" id="rules">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-3 font-[family-name:var(--font-display)] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('contribute.rules.title')}
        </h2>
        <p class="mb-8 text-[1rem] leading-[1.9] text-[#6b7280]">
          {t('contribute.rules.lead')}
        </p>
        <ul class="m-0 flex list-none flex-col gap-0 p-0">
          {
            rules.map((r) => (
              <li class="border-t border-[#e5e7eb] py-5 pl-6 text-[1.05rem] font-semibold leading-[1.9] text-[#252126] first:border-t-0 first:pt-0 [border-left:3px_solid_#E4007E] max-[480px]:pl-4">
                {r}
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section class="bg-[#fafbfc] px-8 py-16 max-[480px]:px-4" id="soon">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-3 font-[family-name:var(--font-display)] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('contribute.soon.title')}
        </h2>
        <p class="mb-8 text-[1rem] leading-[1.9] text-[#6b7280]">
          {t('contribute.soon.lead')}
        </p>
        <dl class="m-0">
          {
            soon.map((s) => (
              <div class="border-t border-[#e5e7eb] py-6 first:border-t-0 first:pt-0">
                <dt class="m-0 text-[1.05rem] font-bold text-[#252126]">
                  {s.title}
                </dt>
                <dd class="m-0 mt-2 text-[1rem] leading-[1.9] text-[#4b5563]">
                  {s.body}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="px-8 py-16 max-[480px]:px-4" id="contact">
      <div class="mx-auto max-w-[var(--container-prose)] text-center">
        <h2
          class="mb-4 font-[family-name:var(--font-display)] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('contribute.contact.title')}
        </h2>
        <p
          class="mx-auto mb-8 max-w-[600px] text-[1rem] leading-[1.9] text-[#4b5563]"
        >
          {t('contribute.contact.body')}
        </p>
        <div
          class="flex flex-wrap justify-center gap-4 max-[480px]:flex-col max-[480px]:items-center"
        >
          <a
            href={`mailto:${CONTACT}`}
            data-ga-section="contribute_contact"
            data-ga-label="email"
            class="rounded-lg bg-[#252126] px-8 py-3 text-[0.95rem] font-semibold text-white no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#E4007E]"
            >{CONTACT}</a
          >
          <a
            href={`${langPrefix}/about`}
            data-ga-section="contribute_contact"
            data-ga-label="about"
            class="rounded-lg border-2 border-[#252126] bg-white px-8 py-3 text-[0.95rem] font-semibold text-[#252126] no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#252126] hover:text-white"
            >{isZh ? '關於這個站' : 'About this site'}</a
          >
        </div>
      </div>
    </section>
  </div>
</Layout>
