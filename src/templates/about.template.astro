---
/**
 * about.template.astro — 關於 COMPUTEX.md
 *
 * 2026-07-29 整份重寫。取種帶進來的是 taiwan-md 的 about：2,531 行、八個區塊，
 * 內容是「為什麼叫 Taiwan.md」的命名故事、母體創辦人的個人敘事、母體的贊助商
 * 名單（justfont / Protico / Portaly 三家真實公司）、母體的演講投影片連結、
 * 母體的 Semiont 十二器官導覽。沒有一段是關於這個站的。
 *
 * 逐段改寫不划算也不誠實：那個結構本身是為「一個人策展一個國家」設計的，
 * 這裡要回答的是完全不同的三個問題 —— 這是誰做的、憑什麼相信它、我怎麼改它。
 * 所以整份換掉。
 *
 * 這一頁對外的功能很單一：它是提案給外貿協會之前，對方會點開的第一頁。
 * 所以「非官方」的聲明放在最前面而不是頁尾，資料來源與更新方式寫成可查證的
 * 句子而不是形容詞，數字一律現算。
 */
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import { getLangFromUrl, useTranslations } from '../i18n/utils';
import { getArchiveStats } from '../lib/archive-stats';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const isZh = lang === 'zh-TW';
const stats = getArchiveStats(lang);
const langPrefix = isZh ? '' : `/${lang}`;

/** 編輯憲章三層。跟首頁 HowItWorks 同一組規則，這裡寫到可以照著審 PR 的細度。 */
const layers = [
  {
    n: '01',
    title: t('about.layers.fact.title'),
    body: t('about.layers.fact.body'),
    who: t('about.layers.fact.who'),
  },
  {
    n: '02',
    title: t('about.layers.curation.title'),
    body: t('about.layers.curation.body'),
    who: t('about.layers.curation.who'),
  },
  {
    n: '03',
    title: t('about.layers.blank.title'),
    body: t('about.layers.blank.body'),
    who: t('about.layers.blank.who'),
  },
];

/** 現算的數字。這一頁不放任何寫死的統計。 */
const figures = [
  { value: String(stats.vendors), label: t('about.figures.vendors') },
  { value: String(stats.returning), label: t('about.figures.returning') },
  {
    value: stats.earliestYear
      ? `${stats.earliestYear}-${stats.latestYear}`
      : '—',
    label: t('about.figures.span'),
  },
  { value: String(stats.totalPages), label: t('about.figures.pages') },
];

const sourceRows = [
  ['about.sources.where.q', 'about.sources.where.a'],
  ['about.sources.how.q', 'about.sources.how.a'],
  ['about.sources.when.q', 'about.sources.when.a'],
  ['about.sources.wrong.q', 'about.sources.wrong.a'],
] as const;

const faqs = [
  { q: t('about.faq.official.q'), a: t('about.faq.official.a') },
  { q: t('about.faq.consent.q'), a: t('about.faq.consent.a') },
  { q: t('about.faq.remove.q'), a: t('about.faq.remove.a') },
  { q: t('about.faq.ai.q'), a: t('about.faq.ai.a') },
  { q: t('about.faq.license.q'), a: t('about.faq.license.a') },
  { q: t('about.faq.lineage.q'), a: t('about.faq.lineage.a') },
];

const REPO = 'https://github.com/hansai-art/computex-md';
---

<Layout
  lang={lang}
  title={t('about.meta.title')}
  description={t('about.meta.description')}
  readerSettings={true}
>
  <div class="about-page">
    <section id="story">
      <PageHero
        containerWidth="wide"
        padding="default"
        titleColor="#252126"
        title={t('about.hero.title')}
        subtitle={t('about.hero.subtitle')}
      />

      <div
        class="mx-auto max-w-[var(--container-prose)] px-8 pb-16 max-[480px]:px-4"
      >
        {/* 非官方聲明放最前面：這是讀者最該先知道的一件事，不是頁尾小字。 */}
        <div
          class="rounded-xl border border-[#e5e7eb] border-l-[3px] border-l-[#E4007E] bg-[#fafbfc] p-6 max-[480px]:p-4"
        >
          <p
            class="m-0 text-[0.95rem] font-semibold leading-[1.9] text-[#252126]"
          >
            {t('about.disclaimer.zh')}
          </p>
          <p class="m-0 mt-3 text-[0.9rem] leading-[1.8] text-[#6b7280]">
            {t('about.disclaimer.en')}
          </p>
        </div>

        <p class="mt-10 text-[1.05rem] leading-[2] text-[#374151]">
          {t('about.intro.p1')}
        </p>
        <p class="mt-5 text-[1.05rem] leading-[2] text-[#374151]">
          {t('about.intro.p2')}
        </p>
        <p class="mt-5 text-[1.05rem] leading-[2] text-[#374151]">
          {t('about.intro.p3')}
        </p>
      </div>
    </section>

    <section class="bg-[#fafbfc] px-8 py-16 max-[480px]:px-4" id="why-md">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-6 font-['jf-lanyangming','Noto_Serif_TC','Source_Han_Serif_TC',serif] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('about.md.title')}
        </h2>
        <p class="text-[1.05rem] leading-[2] text-[#374151]">
          {t('about.md.p1')}
        </p>
        <p class="mt-5 text-[1.05rem] leading-[2] text-[#374151]">
          {t('about.md.p2')}
        </p>
        <p class="mt-6">
          <a
            href={`${langPrefix}/vendors`}
            class="inline-block border-b-2 border-[#E4007E] pb-1 text-[0.95rem] font-semibold text-[#252126] no-underline transition-colors duration-200 hover:text-[#E4007E]"
            >{t('about.md.cta')}</a
          >
        </p>
      </div>
    </section>

    <section class="px-8 py-16 max-[480px]:px-4" id="charter">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-3 font-['jf-lanyangming','Noto_Serif_TC','Source_Han_Serif_TC',serif] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('about.charter.title')}
        </h2>
        <p class="mb-10 text-[1rem] leading-[1.9] text-[#6b7280]">
          {t('about.charter.lead')}
        </p>

        <ol class="m-0 flex list-none flex-col gap-0 p-0">
          {
            layers.map((l) => (
              <li class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-2 border-t border-[#e5e7eb] py-8 first:border-t-0 first:pt-0 max-[480px]:gap-x-4 max-[480px]:py-6">
                <span
                  class="row-span-3 pt-1 text-[1.05rem] font-bold text-[#E4007E] [font-variant-numeric:tabular-nums]"
                  aria-hidden="true"
                >
                  {l.n}
                </span>
                <h3 class="m-0 text-[1.2rem] font-bold leading-snug text-[#252126]">
                  {l.title}
                </h3>
                <p class="m-0 text-[1rem] leading-[1.9] text-[#4b5563]">
                  {l.body}
                </p>
                <p class="m-0 text-[0.9rem] leading-[1.8] text-[#6b7280]">
                  <strong class="font-semibold text-[#374151]">
                    {t('about.layers.whoLabel')}
                  </strong>{' '}
                  {l.who}
                </p>
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="bg-[#fafbfc] px-8 py-16 max-[480px]:px-4" id="sources">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-6 font-['jf-lanyangming','Noto_Serif_TC','Source_Han_Serif_TC',serif] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('about.sources.title')}
        </h2>
        <dl class="m-0 grid grid-cols-1 gap-0">
          {
            sourceRows.map(([q, a]) => (
              <div class="border-t border-[#e5e7eb] py-6 first:border-t-0 first:pt-0">
                <dt class="m-0 text-[1rem] font-bold text-[#252126]">{t(q)}</dt>
                <dd class="m-0 mt-2 text-[1rem] leading-[1.9] text-[#4b5563]">
                  {t(a)}
                </dd>
              </div>
            ))
          }
        </dl>

        <div
          class="mt-10 grid grid-cols-4 gap-4 border-t border-[#e5e7eb] pt-10 max-[640px]:grid-cols-2"
        >
          {
            figures.map((f) => (
              <div class="text-center">
                <div class="text-[1.8rem] font-bold leading-tight text-[#252126] [font-variant-numeric:tabular-nums] max-[480px]:text-[1.4rem]">
                  {f.value}
                </div>
                <div class="mt-1 text-[0.8rem] tracking-[0.04em] text-[#9ca3af]">
                  {f.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="px-8 py-16 max-[480px]:px-4" id="lineage">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-6 font-['jf-lanyangming','Noto_Serif_TC','Source_Han_Serif_TC',serif] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('about.lineage.title')}
        </h2>
        <p class="text-[1.05rem] leading-[2] text-[#374151]">
          {t('about.lineage.p1')}
        </p>
        <p class="mt-5 text-[1.05rem] leading-[2] text-[#374151]">
          {t('about.lineage.p2')}
        </p>
        <ul
          class="mt-6 flex list-none flex-col gap-3 border-t border-[#e5e7eb] p-0 pt-6"
        >
          <li class="text-[0.95rem] leading-[1.9] text-[#4b5563]">
            <strong class="font-semibold text-[#252126]"
              >{t('about.lineage.parentLabel')}</strong
            >{' '}
            <a
              href="https://github.com/frank890417/taiwan-md"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#252126] underline decoration-[#E4007E] underline-offset-2"
              >frank890417/taiwan-md</a
            >
          </li>
          <li class="text-[0.95rem] leading-[1.9] text-[#4b5563]">
            <strong class="font-semibold text-[#252126]"
              >{t('about.lineage.contentLicenseLabel')}</strong
            >{' '}
            <a
              href="https://creativecommons.org/licenses/by/4.0/deed.zh-tw"
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#252126] underline decoration-[#E4007E] underline-offset-2"
              >CC BY 4.0</a
            >
          </li>
          <li class="text-[0.95rem] leading-[1.9] text-[#4b5563]">
            <strong class="font-semibold text-[#252126]"
              >{t('about.lineage.codeLicenseLabel')}</strong
            >{' '}
            MIT
          </li>
          <li class="text-[0.95rem] leading-[1.9] text-[#4b5563]">
            <strong class="font-semibold text-[#252126]"
              >{t('about.lineage.repoLabel')}</strong
            >{' '}
            <a
              href={REPO}
              target="_blank"
              rel="noopener noreferrer"
              class="text-[#252126] underline decoration-[#E4007E] underline-offset-2"
              >hansai-art/computex-md</a
            >
          </li>
        </ul>
      </div>
    </section>

    <section class="bg-[#fafbfc] px-8 py-16 max-[480px]:px-4" id="faq">
      <div class="mx-auto max-w-[var(--container-prose)]">
        <h2
          class="mb-8 font-['jf-lanyangming','Noto_Serif_TC','Source_Han_Serif_TC',serif] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('about.faq.title')}
        </h2>
        <dl class="m-0">
          {
            faqs.map((f) => (
              <div class="border-t border-[#e5e7eb] py-6 first:border-t-0 first:pt-0">
                <dt class="m-0 text-[1.05rem] font-bold leading-snug text-[#252126]">
                  {f.q}
                </dt>
                <dd class="m-0 mt-3 text-[1rem] leading-[1.9] text-[#4b5563]">
                  {f.a}
                </dd>
              </div>
            ))
          }
        </dl>
      </div>
    </section>

    <section class="px-8 py-16 max-[480px]:px-4" id="contact">
      <div class="mx-auto max-w-[var(--container-prose)] text-center">
        <h2
          class="mb-4 font-['jf-lanyangming','Noto_Serif_TC','Source_Han_Serif_TC',serif] text-[1.8rem] font-light text-[#252126] max-[480px]:text-[1.5rem]"
        >
          {t('about.contact.title')}
        </h2>
        <p
          class="mx-auto mb-8 max-w-[600px] text-[1rem] leading-[1.9] text-[#4b5563]"
        >
          {t('about.contact.body')}
        </p>
        <div
          class="flex flex-wrap justify-center gap-4 max-[480px]:flex-col max-[480px]:items-center"
        >
          <a
            href={`${REPO}/issues/new`}
            target="_blank"
            rel="noopener noreferrer"
            data-ga-section="about_contact"
            data-ga-label="issue"
            class="rounded-lg bg-[#252126] px-8 py-3 text-[0.95rem] font-semibold text-white no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#E4007E]"
            >{t('about.contact.issue')}</a
          >
          <a
            href={`${langPrefix}/contribute`}
            data-ga-section="about_contact"
            data-ga-label="contribute"
            class="rounded-lg border-2 border-[#252126] bg-white px-8 py-3 text-[0.95rem] font-semibold text-[#252126] no-underline transition-all duration-300 hover:-translate-y-0.5 hover:bg-[#252126] hover:text-white"
            >{t('about.contact.contribute')}</a
          >
          <a
            href="mailto:hans@groupg.org"
            data-ga-section="about_contact"
            data-ga-label="email"
            class="rounded-lg border-2 border-[#e5e7eb] bg-white px-8 py-3 text-[0.95rem] font-semibold text-[#4b5563] no-underline transition-all duration-300 hover:-translate-y-0.5 hover:border-[#252126] hover:text-[#252126]"
            >hans@groupg.org</a
          >
        </div>
      </div>
    </section>
  </div>
</Layout>
