---
/**
 * home.template.astro — 首頁 template（zh-TW + en 共用）
 *
 * 2026-07-29 首頁本體改寫。取種自 taiwan-md 之後，這支曾經是「四個展廳 ×
 * 三段台灣敘事 + A 級文章精選」的結構，那是母體 863 篇散文的正確形狀，
 * 不是本站 86 頁事實層的形狀。逐段換掉的理由寫在各元件檔頭。
 *
 * 拿掉的四段與理由：
 *   CoverStory        八段台灣引言時間軸 → HowItWorks 三條編輯規則
 *   四個展廳          硬寫的台灣敘事 + 永遠空的精選 → ArchiveShelf 清點
 *   OrganismPreview   台灣島 SVG 中心節點 + 連到不存在的 /semiont → VitalsStrip
 *   ReadingPath       門檻是 15 個腳註，事實層頁面永遠是 0 → 移除
 *   LanguageStatement 「為什麼用繁體中文」是母體的語言主權宣言，不是本站命題
 *   NewsletterSection 表單 action 直接送到母體的 Google Form，等於把本站訪客
 *                     的 email 灌進別人的收件匣
 *   CommunityFeedback 30 幾則真實姓名的讀者留言，內容全是在稱讚 taiwan.md。
 *                     搬過來就是把真實個人的話錯置到另一個專案上（跟 README
 *                     貢獻者名單同一類問題）
 */
import { withTrailingSlash } from '../utils/href';
import Layout from '../layouts/Layout.astro';
import HeroSection from '../components/home/HeroSection.astro';
import ReaderDoors from '../components/home/ReaderDoors.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import VitalsStrip from '../components/home/VitalsStrip.astro';
import ArchiveShelf from '../components/home/ArchiveShelf.astro';
import RandomDiscovery from '../components/home/RandomDiscovery.astro';
import FeatureCards from '../components/FeatureCards.astro';
import CategoryGrid from '../components/CategoryGrid.astro';
import RecentUpdates from '../components/home/RecentUpdates.astro';
import ContributeSection from '../components/home/ContributeSection.astro';
import { fetchRecentCommits } from '../lib/commits';
import { useTranslations, getLangFromUrl } from '../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const recentCommits = await fetchRecentCommits();

// langUrlPrefix: '' for zh-TW（SSOT 根），其他語言是 '/{lang}'。
const isZh = lang === 'zh-TW';
const langUrlPrefix = isZh ? '' : `/${lang}`;
---

<Layout
  lang={lang}
  title={t('home.meta.title')}
  description={t('home.meta.description')}
  readerSettings
>
  <div class="home-page">
    <div data-ga-view="hero"><HeroSection /></div>

    <div data-ga-view="reader_doors"><ReaderDoors /></div>

    <div id="how-it-works" data-ga-view="how_it_works">
      <HowItWorks />
    </div>

    <div id="random-discovery" data-ga-view="random_discovery">
      <RandomDiscovery />
    </div>

    <div data-ga-view="feature_cards">
      <FeatureCards
        lang={lang}
        sectionTitle={t('home.features.title')}
        cards={[
          {
            icon: '🎯',
            title: t('home.features.curated.title'),
            description: t('home.features.curated.desc'),
          },
          {
            icon: '🤖',
            title: t('home.features.ai.title'),
            description: t('home.features.ai.desc'),
          },
          {
            icon: '🌍',
            title: t('home.features.bilingual.title'),
            description: t('home.features.bilingual.desc'),
          },
          {
            icon: '📚',
            title: t('home.features.complete.title'),
            description: t('home.features.complete.desc'),
          },
        ]}
      >
        <div
          class="mt-8 flex flex-wrap justify-center gap-4 px-4 max-[480px]:flex-col max-[480px]:items-center"
        >
          <a
            href={withTrailingSlash(`${langUrlPrefix}/organism`)}
            data-ga-section="feature_cta"
            data-ga-label="organism"
            class="inline-flex items-center gap-2 rounded-lg border-[1.5px] border-[#e5e7eb] bg-white px-6 py-[0.7rem] text-[0.9rem] font-semibold text-[#252126] no-underline transition-all duration-[250ms] hover:-translate-y-px hover:border-[#E4007E]/40 hover:text-[#E4007E] hover:shadow-[0_2px_8px_rgba(37,33,38,0.08)]"
            >{t('home.features.cta.organism')}</a
          >
          <a
            href="https://github.com/hansai-art/computex-md/tree/main/knowledge"
            target="_blank"
            rel="noopener noreferrer"
            data-ga-section="feature_cta"
            data-ga-label="ssot"
            class="inline-flex items-center gap-2 rounded-lg border-[1.5px] border-[#d1d5db] bg-[#f8fafc] px-6 py-[0.7rem] text-[0.9rem] font-semibold text-[#374151] no-underline transition-all duration-[250ms] hover:-translate-y-px hover:border-[#9ca3af] hover:bg-[#f1f5f9] hover:shadow-[0_2px_8px_rgba(0,0,0,0.06)]"
            >{t('home.features.cta.ssot')}</a
          >
        </div>
      </FeatureCards>
    </div>

    <div data-ga-view="vitals_strip"><VitalsStrip /></div>

    <section class="my-24" data-ga-view="archive_shelf">
      <ArchiveShelf />

      <div
        id="categories"
        class="mx-auto my-12 flex max-w-[var(--container-prose)] items-center px-8 max-[480px]:px-4"
      >
        <div
          class="h-px flex-1 bg-[linear-gradient(90deg,transparent,#d1d5db,transparent)]"
        >
        </div>
        <span
          class="whitespace-nowrap px-6 font-[family-name:var(--font-display)] text-[1.3rem] font-bold tracking-[0.05em] text-[#252126]"
          >{t('home.categories.divider')}</span
        >
        <div
          class="h-px flex-1 bg-[linear-gradient(90deg,transparent,#d1d5db,transparent)]"
        >
        </div>
      </div>

      <div data-ga-view="category_grid"><CategoryGrid /></div>
    </section>

    <div data-ga-view="recent_updates">
      <RecentUpdates commits={recentCommits} />
    </div>

    <div data-ga-view="contribute"><ContributeSection /></div>
  </div>
</Layout>

{
  /*
    首頁的 .hall-* / .pick-* / .topic-pill 全域樣式在 2026-07-29 隨四個展廳一起
    刪除。它們是母體 8 個展廳共用的卡片語法，展廳沒了之後沒有任何 markup 掛得上，
    留著只會讓下一個人以為首頁還有那個結構。
  */
}
