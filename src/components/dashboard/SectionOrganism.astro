---
// SectionOrganism — 🧬 Organism Anatomy section (#organism). Ids/classes are a
// contract with src/scripts/dashboard-client.js and src/styles/dashboard/ — do not rename.
import { getLangFromUrl, useTranslations } from '../../i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<!-- Organism Anatomy -->
<section class="section" id="organism">
  <h2 class="section-title">
    {t('dashboard.organism.title')}
    <span class="section-timestamp" data-source="organism"></span>
  </h2>
  <p class="section-subtitle">{t('dashboard.organism.subtitle')}</p>
  <div class="organ-grid" id="organ-grid"></div>
</section>
