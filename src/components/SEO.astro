---
import { existsSync } from 'node:fs';
import { resolve } from 'node:path';
import {
  LANGUAGES,
  ENABLED_LANGUAGE_CODES,
  DEFAULT_LANGUAGE,
  getLanguage,
  type Lang,
} from '../config/languages';
import { getLiveArticleCount } from '../utils/liveStats';
import { getLangSwitchPath } from '../utils/getLangSwitchPath';

// Live article count from prebuilt vitals so SEO meta tracks reality.
// 2026-06-10 audit #5: hoisted to module-level cache (was a per-render
// readFileSync = 8,400+ syscalls/build). Fallback 752 preserved.
const _liveArticleCount = getLiveArticleCount(752);

interface Props {
  title: string;
  description?: string;
  image?: string;
  url?: string;
  lang?: Lang;
  type?: 'website' | 'article';
  datePublished?: string;
  dateModified?: string;
  content?: string;
  tags?: string[];
  category?: string;
  slug?: string;
  categorySlug?: string;
  /** Article/item pairs for the CollectionPage ItemList (hub pages). See
   * collectionTotal for the count when it differs from this array's length
   * (e.g. truncated to the first N items). */
  collectionItems?: { name: string; url: string }[];
  /** Total item count for the CollectionPage ItemList's numberOfItems.
   * Defaults to collectionItems.length when omitted — pass explicitly when
   * collectionItems is truncated (e.g. a category with 300 articles only
   * lists the first 100). */
  collectionTotal?: number;
}

const { lang = 'zh-TW' } = Astro.props;

// 站台預設社交卡。沒有對應文章的頁面（首頁、/about、分類索引、/explore…）全部用它。
//
// 2026-07-29：這裡原本寫死母體的 `/images/taiwan-social.jpg`，而這個 repo 連
// `public/images/` 這個資料夾都不存在 —— 86 篇廠商頁以外的每一頁，對外宣告的
// og:image 都是 404。純靠 build 綠燈看不出來（沒有任何一支檢查在驗 meta 裡的
// 圖片路徑），所以同一個 commit 補了 `scripts/tools/verify-og-images.mjs`。
const siteCard =
  lang === DEFAULT_LANGUAGE.code
    ? '/og-images/site-card.jpg'
    : `/og-images/${lang}/site-card.jpg`;

const {
  title,
  description = lang === 'zh-TW'
    ? `COMPUTEX 與台灣 AI 硬體產業的開放檔案庫，目前收錄 ${_liveArticleCount} 頁。每一項事實附出處連結與查證日期，官方沒公布的一律留白，不推測。`
    : `An open archive of COMPUTEX and the Taiwan AI hardware industry, currently ${_liveArticleCount} pages. Every fact carries a source link and a checked date; what the organiser has not published is left blank, never inferred.`,
  image = siteCard,
  url = Astro.url.href,
  type = 'website',
  datePublished,
  dateModified,
  content,
  tags,
  category,
  slug,
  categorySlug,
  collectionItems,
  collectionTotal,
} = Astro.props;

const fullTitle = `${title} | COMPUTEX.md`;
const siteUrl = 'https://computex-md.pages.dev';

// Per-locale URLs for the hreflang cluster. Shares the module-level registry
// cache with Header.astro's switcher, so this costs one Map lookup per page.
//
// Slugs diverge per language for the same article (People/李珠珢.md is
// en/lee-ju-eun but ja/ko/es/fr/lee-ju-eun-singer), so a locale prefix can
// never be swapped onto the current slug — that manufactures 404s (13,014
// dead alternates across 99.8% of pages before 2026-07-17). The registry is
// the only thing that knows each locale's real URL, and the has* flags are
// the only thing that knows whether a translation exists at all. Header.astro
// already resolves the visible switcher this way; the machine-readable tags
// must agree with it. Computed here in frontmatter — the Astro template
// expression scanner mis-parses generics and nested template literals.
const langSwitch = await getLangSwitchPath(new URL(url).pathname);

// Generic across all ENABLED_LANGUAGE_CODES (was hardcoded to 6 langs until
// 2026-07-24 — vi/id/pt/hi never got hreflang tags despite having real
// translated content, per langSwitch.langs added the same day).
const _hreflangLink: Record<string, string | undefined> = Object.fromEntries(
  ENABLED_LANGUAGE_CODES.map((c) => [
    c,
    langSwitch.langs?.[c]?.has ? langSwitch.langs[c]?.link : undefined,
  ]),
);

// Match the canonical's trailing slash so alternates resolve 200, not 301.
// Registry values mix percent-encoded zh URLs (toZh side) and raw CJK
// filenames (native lang slugs). encodeURI escapes bare '%', so running it
// over an already-encoded path double-encodes (%E6 → %25E6) — only encode
// paths that carry no %XX sequences yet.
const _absAlt = (p: string) => {
  const withSlash = p.endsWith('/') ? p : p + '/';
  const alreadyEncoded = /%[0-9A-Fa-f]{2}/.test(withSlash);
  return siteUrl + (alreadyEncoded ? withSlash : encodeURI(withSlash));
};

const hreflangTags = ENABLED_LANGUAGE_CODES.filter((c) => _hreflangLink[c]).map(
  (c) => ({
    hreflang: getLanguage(c)?.hreflang || c,
    href: _absAlt(_hreflangLink[c] as string),
  }),
);

const _defaultAlt = _hreflangLink[DEFAULT_LANGUAGE.code];
const hreflangDefault = _defaultAlt ? _absAlt(_defaultAlt) : null;

// A one-entry cluster tells Google nothing; omit rather than self-declare.
const emitHreflang = hreflangTags.length >= 2;

// OG image strategy (2026-04-22 β):
//   - Article pages: per-article OG at /og-images/[lang]/[cat]/[slug].jpg
//   - Generated by `scripts/core/generate-og-images.mjs` via article `?shot=1`
//     mode (unified with spore-image pipeline — single rendering source)
//   - JPG 85 only（vs PNG -70% 體積，1200×630 社交圖視覺無差）
//   - 用 existsSync 在 build time 檢查檔案，若不存在退回預設 social card
//     （避免 og:image URL 404 被社群平台抓空）
let finalImage = image;
if (type === 'article' && categorySlug && slug && image === siteCard) {
  const isDefaultLang = lang === 'zh-TW';
  const pathPrefix = isDefaultLang
    ? `/og-images/${categorySlug}`
    : `/og-images/${lang}/${categorySlug}`;
  // URL 用 percent-encoded（瀏覽器/社群平台最穩）；
  // 檔案系統檢查用原始 UTF-8（與 og:generate 腳本實際寫入的檔名一致）
  const urlBase = `${pathPrefix}/${encodeURIComponent(slug)}`;
  const diskBase = `${pathPrefix}/${slug}`;

  const jpgFull = resolve(
    process.cwd(),
    'public',
    diskBase.replace(/^\//, '') + '.jpg',
  );

  if (existsSync(jpgFull)) {
    finalImage = `${urlBase}.jpg`;
  }
  // else: finalImage 維持站台預設卡
}

const fullImageUrl = new URL(finalImage, siteUrl).href;

// Generate AI-friendly summary from description or content
const aiSummary =
  description ||
  (content
    ? content
        .substring(0, 200)
        .replace(/[\n\r]/g, ' ')
        .replace(/[#*]/g, '')
        .trim() + '...'
    : '');

// Generate JSON-LD structured data
const generateJSONLD = () => {
  // Person pages (people category) — gated on type === 'article' so the
  // /people (or /en/people etc.) HUB page — which also carries
  // category === 'People'/'people' — doesn't get misdescribed as a single
  // Person. 2026-07-10 fix (was firing on the hub listing page too).
  if (type === 'article' && (category === 'people' || category === 'People')) {
    return {
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: title,
      description: description,
      url: url,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': url,
      },
      ...(datePublished && { birthDate: datePublished }),
    };
  }

  // Article pages
  if (type === 'article' && datePublished) {
    return {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description: description,
      author: {
        '@type': 'Organization',
        name: 'COMPUTEX.md',
        url: siteUrl,
      },
      publisher: {
        '@type': 'Organization',
        name: 'COMPUTEX.md',
        url: siteUrl,
        logo: {
          '@type': 'ImageObject',
          url: `${siteUrl}${siteCard}`,
          width: 1200,
          height: 630,
        },
      },
      datePublished: datePublished,
      dateModified: dateModified || datePublished,
      inLanguage: lang,
      url: url,
      image: {
        '@type': 'ImageObject',
        url: fullImageUrl,
        width: 1200,
        height: 630,
      },
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': url,
      },
      ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
      ...(category && { articleSection: category }),
    };
  }

  // Website root
  return {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name:
      lang === 'zh-TW'
        ? 'COMPUTEX.md：台灣 AI 硬體產業活體年鑑'
        : 'COMPUTEX.md — Knowledge Base',
    description:
      lang === 'zh-TW'
        ? '參展廠商、產品、歷屆展會的結構化開放資料。事實層機械抽取自官方名錄，逐項附出處；策展層由中立編輯撰寫，廠商不能改。'
        : 'Structured open data on COMPUTEX exhibitors, products and editions. The fact layer is extracted mechanically from the official directory with per-item sources; the curation layer is written by neutral editors.',
    url: siteUrl,
    inLanguage: lang,
    publisher: {
      '@type': 'Organization',
      name: 'COMPUTEX.md',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}${siteCard}`,
        width: 1200,
        height: 630,
      },
    },
    // 2026-05-27: point SearchAction at /explore (the actual search-first
    // UX, shipped 2026-05-10) instead of the non-existent /search route.
    potentialAction: {
      '@type': 'SearchAction',
      target: {
        '@type': 'EntryPoint',
        urlTemplate: `${siteUrl}/explore?q={search_term_string}`,
      },
      'query-input': 'required name=search_term_string',
    },
    // 同上：只列真的由本站控制的帳號。
    sameAs: ['https://github.com/hansai-art/computex-md'],
  };
};

const jsonLD = generateJSONLD();

// Organization Schema for all pages.
// 2026-05-27 Wave 2 / Phase 7: expanded for AI reader SEO (PerplexityBot /
// OAI-SearchBot / GPTBot / Googlebot) per LONGINGS §擴散渴望 #4. Added:
//   - `knowsAbout` topical authority signals (12 category domains)
//   - `inLanguage` explicit list of all 6 enabled locales
//   - `slogan` for cite-able tagline
// See reports/homepage-evolution-2026-05-26.md §Gap 5.
const organizationLD = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'COMPUTEX.md',
  alternateName: ['COMPUTEX.md', 'computex.md'],
  url: siteUrl,
  logo: `${siteUrl}/favicon.png`,
  description:
    lang === 'zh-TW'
      ? 'COMPUTEX 與台灣 AI 硬體產業的開放檔案庫。事實層可查證、策展層中立，非 COMPUTEX 或外貿協會官方網站。'
      : 'An open archive of COMPUTEX and the Taiwan AI hardware industry. Verifiable fact layer, neutral curation layer. Not affiliated with COMPUTEX or TAITRA.',
  slogan:
    lang === 'zh-TW'
      ? '官方沒公布的，我們就留白'
      : "What the organiser hasn't published stays blank",
  foundingDate: '2026-07-28',
  inLanguage: ENABLED_LANGUAGE_CODES,
  knowsAbout: [
    'COMPUTEX',
    'COMPUTEX Taipei',
    'Taiwan AI hardware industry',
    'AI server supply chain',
    'Trade show exhibitor data',
    'Taipei Nangang Exhibition Center',
    'Data center cooling',
    'Edge AI computing',
    'Semiconductor industry',
  ],
  // sameAs 只列真的由本站控制的帳號。取種時這裡有 x / instagram / threads
  // 三個 @computexmd handle，那是把母體的 @taiwanmd 做字串取代得到的，
  // 我們沒有註冊過任何一個 —— 對爬蟲宣告「這些帳號是我們」是可查證的假話，
  // 而且那些 handle 可能真的屬於別人。開了帳號再加回來。
  sameAs: ['https://github.com/hansai-art/computex-md'],
  contactPoint: {
    '@type': 'ContactPoint',
    email: 'hans@groupg.org',
    contactType: 'Customer Support',
  },
};

// WebSite schema with SearchAction — registers internal search with crawlers.
// Helps Google Sitelinks Search Box + LLM crawlers know we have a queryable
// knowledge base (not just a static blog).
const websiteLD = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'COMPUTEX.md',
  url: siteUrl,
  inLanguage: ENABLED_LANGUAGE_CODES,
  potentialAction: {
    '@type': 'SearchAction',
    target: {
      '@type': 'EntryPoint',
      urlTemplate: `${siteUrl}/explore?q={search_term_string}`,
    },
    'query-input': 'required name=search_term_string',
  },
  publisher: {
    '@type': 'Organization',
    name: 'COMPUTEX.md',
    url: siteUrl,
  },
};

// CollectionPage schema — only emitted for the homepage. Tells AI crawlers
// that `/` is the index of a structured knowledge collection across the 12
// category hubs (not just a marketing landing). Each hub is a `hasPart`.
const isHomepage = (() => {
  try {
    const p = new URL(url).pathname.replace(/\/+$/, '/');
    if (p === '/') return true;
    // Non-default lang homepages: /en/ /ja/ /ko/ /fr/ /es/
    return /^\/(en|ja|ko|fr|es)\/?$/.test(p);
  } catch {
    return false;
  }
})();

const HOMEPAGE_CATEGORY_HUBS = [
  'history',
  'geography',
  'culture',
  'food',
  'art',
  'music',
  'technology',
  'nature',
  'people',
  'society',
  'economy',
  'lifestyle',
];

const homepageCollectionLD = isHomepage
  ? {
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      '@id': url,
      url: url,
      name: title,
      description: description,
      inLanguage: lang,
      isPartOf: {
        '@type': 'WebSite',
        '@id': siteUrl,
        name: 'COMPUTEX.md',
      },
      mainEntity: {
        '@type': 'ItemList',
        name:
          lang === 'zh-TW'
            ? 'COMPUTEX.md 知識策展 12 大主題'
            : 'COMPUTEX.md 12 curated knowledge domains',
        numberOfItems: HOMEPAGE_CATEGORY_HUBS.length,
        itemListElement: HOMEPAGE_CATEGORY_HUBS.map((slug, i) => {
          // For non-default langs, hub URL has lang prefix
          const langPrefix = lang === DEFAULT_LANGUAGE.code ? '' : `/${lang}`;
          return {
            '@type': 'ListItem',
            position: i + 1,
            item: {
              '@type': 'CollectionPage',
              '@id': `${siteUrl}${langPrefix}/${slug}`,
              url: `${siteUrl}${langPrefix}/${slug}`,
              name: slug,
            },
          };
        }),
      },
    }
  : null;

// CollectionPage schema for non-homepage collections (category hubs, /latest,
// etc.) — same shape as homepageCollectionLD but caller-supplied via
// `collectionItems`/`collectionTotal` instead of the hardcoded 12-hub list
// above, and explicitly excluded from the homepage (which already gets its
// own richer homepageCollectionLD with named sub-CollectionPage entities).
// 2026-07-10 category-hub overhaul: lets AI/search crawlers see a category
// hub's full member list (article name + URL) as structured data instead of
// only whatever happens to be in the rendered HTML.
const collectionPageLD =
  collectionItems && collectionItems.length > 0 && !isHomepage
    ? {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        '@id': url,
        url,
        name: title,
        description,
        inLanguage: lang,
        dateModified: dateModified || undefined,
        isPartOf: {
          '@type': 'WebSite',
          '@id': siteUrl,
          name: 'COMPUTEX.md',
        },
        mainEntity: {
          '@type': 'ItemList',
          numberOfItems: collectionTotal ?? collectionItems.length,
          itemListElement: collectionItems.map((it, i) => ({
            '@type': 'ListItem',
            position: i + 1,
            url: it.url,
            name: it.name,
          })),
        },
      }
    : null;

// Dynamic keywords (zh-TW gets Chinese keywords; all other langs get English)
const baseKeywords =
  lang === 'zh-TW'
    ? 'COMPUTEX, 台北國際電腦展, 參展廠商, 攤位號, AI 硬體, 台灣供應鏈, 開放資料'
    : 'COMPUTEX, COMPUTEX Taipei, exhibitor directory, booth number, AI hardware, Taiwan supply chain, open data';

const categoryKeywords = category
  ? lang === 'zh-TW'
    ? [`COMPUTEX ${category}`, `${category} COMPUTEX`]
    : [`COMPUTEX ${category}`, `${category} COMPUTEX`]
  : [];

const dynamicKeywords = [
  baseKeywords,
  ...categoryKeywords,
  ...(tags && tags.length > 0 ? tags : []),
].join(', ');

// BreadcrumbList JSON-LD for content pages
const generateBreadcrumbLD = () => {
  const currentPath = new URL(url).pathname;
  // Non-default locales from the registry
  const nonDefaultLocales = ENABLED_LANGUAGE_CODES.filter(
    (c) => c !== DEFAULT_LANGUAGE.code,
  );

  // Determine locale prefix for URLs
  let localePrefix = '';
  for (const p of nonDefaultLocales) {
    if (lang === p) {
      localePrefix = `/${p}`;
      break;
    }
  }

  // Homepage - no breadcrumb needed
  const homePaths = [
    '/',
    ...nonDefaultLocales.flatMap((l) => [`/${l}`, `/${l}/`]),
  ];
  if (homePaths.includes(currentPath)) {
    return null;
  }

  const baseItems = [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'COMPUTEX.md',
      item: `${siteUrl}${localePrefix || ''}`,
    },
  ];

  // Category page (e.g., /history, /en/culture, /ja/food) — matched on
  // categorySlug (the raw English URL segment), NOT category (the
  // localized display name, e.g. '歷史'/'歴史'/'History'). 2026-07-10 fix:
  // the old `currentPath.endsWith('/' + category)` check compared a
  // translated/capitalized label against a lowercase English path
  // segment, so it never matched for non-en locales (and rarely for en,
  // since categoryInfo.name is capitalized while the URL slug isn't).
  if (
    categorySlug &&
    (currentPath.endsWith(`/${categorySlug}`) ||
      currentPath.endsWith(`/${categorySlug}/`))
  ) {
    return {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        ...baseItems,
        {
          '@type': 'ListItem',
          position: 2,
          name: category,
          item: url,
        },
      ],
    };
  }

  // Article page — categoryUrl prefers categorySlug (same rationale as
  // above); falls back to the old `category`-based URL when a caller
  // doesn't pass categorySlug, so this stays non-breaking for any
  // caller that hasn't been updated to pass it yet.
  if (category && type === 'article') {
    const categoryUrl = categorySlug
      ? `${siteUrl}${localePrefix}/${categorySlug}`
      : `${siteUrl}${localePrefix}/${category}`;
    return {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [
        ...baseItems,
        {
          '@type': 'ListItem',
          position: 2,
          name: category,
          item: categoryUrl,
        },
        {
          '@type': 'ListItem',
          position: 3,
          name: title,
          item: url,
        },
      ],
    };
  }

  // Other pages (about, contribute, etc.)
  return {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      ...baseItems,
      {
        '@type': 'ListItem',
        position: 2,
        name: title,
        item: url,
      },
    ],
  };
};

const breadcrumbLD = generateBreadcrumbLD();
---

<!-- Basic Meta Tags -->
<meta name="description" content={description} />
<meta name="keywords" content={dynamicKeywords} />
<meta name="author" content="COMPUTEX.md" />
<meta name="generator" content="Astro" />
<meta name="theme-color" content="#004d40" />
<meta name="format-detection" content="telephone=no" />

<!-- Additional SEO Meta Tags -->
<meta name="revisit-after" content="7 days" />
<meta name="distribution" content="global" />
<meta name="rating" content="general" />

<!-- AI-friendly summary meta tag -->
<meta name="ai-summary" content={aiSummary} />

<!-- Canonical URL -->
<link rel="canonical" href={url} />

<!-- RSS Feed -->
<link
  rel="alternate"
  type="application/rss+xml"
  title={lang === 'en'
    ? 'COMPUTEX.md RSS Feed (English)'
    : 'COMPUTEX.md RSS 動態消息'}
  href={`${siteUrl}/feed.xml`}
/>

<!-- Preconnect to external resources -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<!-- DNS prefetch -->
<link rel="dns-prefetch" href="//github.com" />
<link rel="dns-prefetch" href="//x.com" />

<!-- Dynamic Language Tags — resolved through the LangMap registry (frontmatter) -->
{
  emitHreflang &&
    hreflangTags.map((t) => (
      <link rel="alternate" hreflang={t.hreflang} href={t.href} />
    ))
}
{
  emitHreflang && hreflangDefault && (
    <link rel="alternate" hreflang="x-default" href={hreflangDefault} />
  )
}

<!-- Open Graph / Facebook -->
<meta property="og:type" content={type} />
<meta property="og:url" content={url} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={fullImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:type" content="image/jpeg" />
<meta property="og:image:alt" content={`${title}｜COMPUTEX.md`} />
<meta
  property="og:site_name"
  content={lang === 'zh-TW'
    ? 'COMPUTEX.md：台灣 AI 硬體產業活體年鑑'
    : 'COMPUTEX.md: a living archive of the Taiwan AI hardware industry'}
/>
<meta
  property="og:locale"
  content={(() => {
    // Map registry hreflang → og:locale format (e.g., 'en' → 'en_US', 'ja' → 'ja_JP')
    const ogLocaleMap: Record<string, string> = {
      'zh-Hant': 'zh_TW',
      en: 'en_US',
      ja: 'ja_JP',
      ko: 'ko_KR',
      es: 'es_ES',
      fr: 'fr_FR',
    };
    const entry = getLanguage(lang);
    return ogLocaleMap[entry?.hreflang || ''] || 'zh_TW';
  })()}
/>
{
  datePublished && (
    <meta property="article:published_time" content={datePublished} />
  )
}
{
  dateModified && (
    <meta property="article:modified_time" content={dateModified} />
  )
}
{
  tags &&
    tags.map((tag: string) => <meta property="article:tag" content={tag} />)
}

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:site" content="@cheyuwu345" />
<meta name="twitter:creator" content="@cheyuwu345" />
<meta name="twitter:url" content={url} />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={fullImageUrl} />
<meta name="twitter:image:alt" content={`${title}｜COMPUTEX.md`} />

<!-- Additional SEO -->
<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify(jsonLD, null, 2)} />
<script
  type="application/ld+json"
  set:html={JSON.stringify(organizationLD, null, 2)}
/>
<script
  type="application/ld+json"
  set:html={JSON.stringify(websiteLD, null, 2)}
/>
{
  homepageCollectionLD && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(homepageCollectionLD, null, 2)}
    />
  )
}
{
  collectionPageLD && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(collectionPageLD, null, 2)}
    />
  )
}
{
  breadcrumbLD && (
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbLD, null, 2)}
    />
  )
}
