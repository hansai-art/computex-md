---
import { CATEGORY_MAPPING, CATEGORY_LIST } from '../config/categories';
import * as fs from 'node:fs';
import * as path from 'node:path';
import TopicCard from './TopicCard.astro';
import {
  getLangFromUrl,
  useTranslations,
  useTranslatedPath,
} from '../i18n/utils';
import { defaultLang } from '../i18n/ui';
import { getCategoryConfigs } from '../utils/categoryConfig';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const categoryConfigs = getCategoryConfigs(t);

// Count articles from knowledge/ directory
function countArticles(categorySlug: string): number {
  const categoryMap = CATEGORY_MAPPING;
  const dirName = categoryMap[categorySlug] || categorySlug;
  const langDir = lang === defaultLang ? '' : lang;
  const dirPath = path.join(process.cwd(), 'knowledge', langDir, dirName);
  try {
    const files = fs.readdirSync(dirPath);
    return files.filter((f) => f.endsWith('.md') && !f.startsWith('_')).length;
  } catch {
    return 0;
  }
}

const articleLabel = t('CategoryGrid.articles');
const ctaLabel = t('CategoryGrid.explore');

// 高度交錯是為了三欄視覺平衡。分類來源是 SSOT，高度依序循環，
// 加分類時不必回來改這張表。
const HEIGHT_CYCLE = ['tall', 'medium', 'short'] as const;
const categories: { slug: string; height: 'tall' | 'medium' | 'short' }[] =
  CATEGORY_LIST.map((slug, i) => ({
    slug,
    height: HEIGHT_CYCLE[i % HEIGHT_CYCLE.length],
  }));
---

<!--
  Phase 4 leaf migration #8: TopicsMasonry.astro
  ──────────────────────────────────────────────
  - Scoped <style> block removed entirely
  - CSS Multi-Column Layout via Tailwind utilities:
    - columns-1 / sm:columns-2 / lg:columns-3
    - gap-x-12 for column-gap
    - break-inside-avoid on each item
  - Padding uses the design token via arbitrary var() syntax
-->
<section
  class="mx-auto max-w-[90rem] columns-1 gap-x-12 [padding-inline:var(--space-page-x,2rem)] sm:columns-2 lg:columns-3"
  aria-label={t('CategoryGrid.aria-section')}
>
  {
    categories.map(({ slug, height }) => {
      const count = countArticles(slug);
      const cfg = categoryConfigs[slug];
      return (
        <article class="mb-12 break-inside-avoid">
          <TopicCard
            slug={slug}
            href={translatePath(`/${slug}`)}
            name={cfg?.name ?? slug}
            description={cfg?.description ?? ''}
            count={count}
            articleLabel={articleLabel}
            ctaLabel={ctaLabel}
            height={height}
          />
        </article>
      );
    })
  }
</section>
